# Copy to `.env` for local development. Production values live in Fly secrets (see README).
# Every app variable is read at runtime from `process.env` on the server — nothing is baked
# into the client bundle at Docker build time (the Dockerfile needs no build args).

# --- Plaid (https://dashboard.plaid.com/developers/keys) ---
# Set on: local `.env` | Fly secrets (production)
PLAID_CLIENT_ID=
PLAID_SECRET=

# sandbox | production
PLAID_ENV=sandbox

# Comma-separated Plaid products for Link (Balance is read via /accounts/get, not here)
PLAID_PRODUCTS=transactions

# Comma-separated ISO country codes
PLAID_COUNTRY_CODES=US

# Days of transaction history to request on Link (default 90, max 730).
# Larger values make the initial backfill take noticeably longer.
PLAID_TRANSACTIONS_DAYS_REQUESTED=90

# 32-byte AES-256 key — 64 hex chars or base64-encoded 32 bytes
# Generate: openssl rand -hex 32
PLAID_TOKEN_ENCRYPTION_KEY=

# Optional. Desktop web opens OAuth banks in a popup and does not need this;
# it is only required for mobile web and webview sessions. Must be HTTPS in
# Production (http://localhost is accepted in Sandbox only).
# Set on: local `.env` | Fly secrets (production, when needed)
# PLAID_REDIRECT_URI=

# Optional — set when using webhooks (Phase 4)
# Set on: local `.env` | Fly secrets (production, when needed)
# PLAID_WEBHOOK_URL=

# Sandbox only: Plaid Link pre-fills this returning-user test number (OTP: 123456).
# Real phone numbers are rejected in Sandbox. Override if needed (E.164 format).
# Set on: local `.env` only
# PLAID_SANDBOX_LINK_PHONE=+14155550010

# --- Clerk (https://dashboard.clerk.com/last-active?path=api-keys) ---
# Set on: local `.env` | Fly secrets (production)
# Despite the VITE_ prefix, the publishable key is served at runtime by rootAuthLoader
# (read from process.env on the server, not import.meta.env in the client bundle).
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Convex (https://dashboard.convex.dev) ---
# Run `bun run convex:dev` to create a project and populate CONVEX_URL / CONVEX_DEPLOYMENT.
# Set on: local `.env` | Fly secrets (production)
CONVEX_URL=

# Shared secret for trusted-server calls from the React Router backend.
# Set on: local `.env` | Fly secrets (production) | Convex deployment env (same value)
# Generate: openssl rand -hex 32
# Local: `bunx convex env set CONVEX_INTERNAL_SECRET`
# Production: `bunx convex env set --prod CONVEX_INTERNAL_SECRET`
CONVEX_INTERNAL_SECRET=

# Local dev pointer — written by `convex dev`; do not set on Fly.
# Set on: local `.env` only (managed by Convex CLI)
# CONVEX_DEPLOYMENT=

# Authenticates `bunx convex deploy` from local machine or CI. Never set on Fly.
# Set on: local machine / CI only (Convex dashboard → Settings → Deploy keys)
# CONVEX_DEPLOY_KEY=
